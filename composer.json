{
  "name": "arnoson/kirby-vite",
  "description": "Vite helper for Kirby CMS",
  "version": "5.7.1",
  "type": "kirby-plugin",
  "license": "MIT",
  "keywords": [
    "vite",
    "kirby3",
    "kirby4",
    "kirby5"
  ],
  "authors": [
    {
      "name": "Arno Schlipf"
    }
  ],
  "scripts": {
    "test": "composer --working-dir=packages/kirby-vite test"
  },
  "require": {
    "getkirby/composer-installer": "^1.2"
  },
  "config": {
    "allow-plugins": {
      "getkirby/composer-installer": true
    }
  },
  "extra": {
    "kirby": {
      "compatible": "^3.7 || ^4.0 || ^5.0 || ^6.0"
    }
  }
}
